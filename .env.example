# Healthcare Multi-Agent AI Platform - Text Extraction Foundation
# Configuration Environment Variables Example

# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_TEXT_MODEL=openai/gpt-oss-20b
GROQ_RESPONSE_MODE=strict_json_schema

# Remote Processing Safety Gate (must be explicitly true to permit external API calls)
ALLOW_REMOTE_LLM_PROCESSING=false

# Clinical Parsing Settings
# DATE_ORDER options: UNKNOWN, DMY, MDY
DATE_ORDER=UNKNOWN

# Chunking & Call Budget Limits
MAX_TEXT_CHARS=36000
MAX_LLM_CHARS_PER_CHUNK=6000
MAX_LLM_CALLS_PER_REQUEST=8
MAX_COMPLETION_TOKENS=2500

# Provider Network Resilience
PROVIDER_TIMEOUT_SECONDS=30.0
PROVIDER_MAX_RETRIES=2
PROVIDER_MAX_CONCURRENCY_PER_REQUEST=1

